@model List<GaragemVeiculos.Models.Veiculo>
@{
    ViewData["Title"] = "Veículos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 text-dark mb-0"><i class="bi bi-truck me-2"></i>Frota de Veículos</h2>
        <small class="text-muted">Cadastro e controle de veículos da frota</small>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Novo Veículo
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-car-front display-6 d-block mb-2"></i>
                Nenhum veículo cadastrado na frota.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 80px;">#ID</th>
                            <th>Placa</th>
                            <th>Marca / Modelo</th>
                            <th>Ano</th>
                            <th>Cor</th>
                            <th class="text-end pe-3" style="width: 180px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var veiculo in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">@veiculo.Id</td>
                                <td>
                                    <span class="badge bg-dark font-monospace px-2 py-1">@veiculo.Placa</span>
                                </td>
                                <td class="fw-semibold text-dark">@veiculo.Marca @veiculo.Modelo</td>
                                <td>@veiculo.Ano</td>
                                <td>@(string.IsNullOrWhiteSpace(veiculo.Cor) ? "-" : veiculo.Cor)</td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@veiculo.Id" class="btn btn-sm btn-outline-secondary me-1" title="Editar">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@veiculo.Id" method="post" class="d-inline" onsubmit="return confirm('Deseja realmente excluir o veículo @veiculo.Modelo (@veiculo.Placa)?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
