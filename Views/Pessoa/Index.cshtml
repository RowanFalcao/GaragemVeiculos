@model List<GaragemVeiculos.Models.Pessoa>
@{
    ViewData["Title"] = "Pessoas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 text-dark mb-0"><i class="bi bi-people me-2"></i>Cadastro de Pessoas</h2>
        <small class="text-muted">Gerenciamento de clientes e motoristas</small>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Nova Pessoa
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-person-x display-6 d-block mb-2"></i>
                Nenhuma pessoa cadastrada no momento.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 80px;">#ID</th>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>E-mail</th>
                            <th>Telefone</th>
                            <th class="text-end pe-3" style="width: 180px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pessoa in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">@pessoa.Id</td>
                                <td class="fw-semibold text-dark">@pessoa.Nome</td>
                                <td><span class="badge bg-light text-dark border">@pessoa.CPF</span></td>
                                <td>@pessoa.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(pessoa.Telefone) ? "-" : pessoa.Telefone)</td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@pessoa.Id" class="btn btn-sm btn-outline-secondary me-1" title="Editar">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@pessoa.Id" method="post" class="d-inline" onsubmit="return confirm('Deseja realmente excluir a pessoa @pessoa.Nome?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
